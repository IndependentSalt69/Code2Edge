{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2edge/contracts/start_run.schema.json",
  "title": "start_run — input and output schemas",
  "description": "Creates a new Code2Edge deployment run and initialises its state file. Every other workflow tool takes the run_id this returns.",

  "$defs": {
    "Input": {
      "type": "object",
      "properties": {
        "requested_by": { "type": "string", "description": "Optional human or agent identifier that started this run" }
      },
      "additionalProperties": false
    },

    "Output": {
      "type": "object",
      "required": ["schema_version","tool","source","run_id","timestamp","status","current_stage","stages"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tool":           { "type": "string", "const": "start_run" },
        "source":         { "type": "string", "enum": ["mock","real"] },
        "run_id":         { "type": "string" },
        "timestamp":      { "type": "string", "format": "date-time" },

        "status":        { "type": "string", "const": "created" },
        "current_stage": { "type": "string" },
        "stages": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered list of stage names this run will pass through"
        }
      },
      "additionalProperties": false
    }
  }
}
